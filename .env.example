# Copy this file to .env and fill in as needed. All defaults run fully offline.

# --- LLM backend: "mock" (default, offline) or "gemini" ---
FIXATION_LLM_BACKEND=mock
FIXATION_GEMINI_API_KEY=
FIXATION_GEMINI_MODEL=gemini-2.5-flash

# --- Embedding backend: "mock" (default, offline) or "sentence-transformers" ---
FIXATION_EMBEDDING_BACKEND=mock
FIXATION_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
FIXATION_EMBEDDING_DIM=384

# --- Database ---
FIXATION_DATABASE_URL=sqlite:///./fixation.db

# --- Fixation detection thresholds ---
FIXATION_FIXATION_WINDOW=6
FIXATION_FIXATION_SIMILARITY_THRESHOLD=0.82
FIXATION_FIXATION_DISPERSION_THRESHOLD=0.15
FIXATION_FIXATION_SCORE_THRESHOLD=0.65

# --- Intervention strategy params ---
FIXATION_FIXED_INTERVAL_TURNS=5
FIXATION_ADAPTIVE_COOLDOWN_TURNS=4
